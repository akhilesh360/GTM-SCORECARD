# Copy to .env (git-ignored) and fill in what you have. Everything is optional:
# with nothing set, the agent runs offline with mock HubSpot/Slack and rules-based scoring.

# DeepSeek fit scoring (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# HubSpot private app token and client secret (webhook signatures)
HUBSPOT_TOKEN=
HUBSPOT_CLIENT_SECRET=

# Slack incoming webhook
SLACK_WEBHOOK_URL=

# Google Sheets sync for Looker Studio
GOOGLE_SHEET_ID=
GOOGLE_ACCESS_TOKEN=
