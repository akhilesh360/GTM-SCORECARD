{
  "_comment": "Portfolio-wide GTM standard. Every company maps onto these definitions; do not edit per company.",
  "channels": [
    "Google Ads",
    "Meta Ads",
    "Outbound",
    "Referral",
    "Call Tracking"
  ],
  "deal_stages": [
    "New",
    "Contacted",
